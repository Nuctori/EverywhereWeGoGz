API_PORT=3001
DATA_DIR=./data
CRAWLER_DIR=./crawler
CRAWL_CRON=0 3 * * *
AUTO_SEED_MOCK_DATA=true

# Public frontend defaults. Values prefixed with VITE_ are bundled into the browser.
# 2026-10-08 起 key 全部收进 Cloudflare Worker 服务端 secrets（cloudflare/ai-proxy），
# 前端 bundle 只有代理地址——客户端不明文。换上游/换 key 用 wrangler secret put，
# deploy.yml 不再持有任何 key。
VITE_AI_DEFAULT_BASE_URL=https://ai.114124.xyz/v1
VITE_AI_DEFAULT_MODEL=GLM-4.7-Flash
VITE_AI_DEFAULT_API_KEY=ewg-proxy
