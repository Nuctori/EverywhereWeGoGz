API_PORT=3001
DATA_DIR=./data
CRAWLER_DIR=./crawler
CRAWL_CRON=0 3 * * *
AUTO_SEED_MOCK_DATA=true

# Public frontend defaults. Values prefixed with VITE_ are bundled into the browser.
# Use only a public demo key with strict quota/domain limits here.
VITE_AI_DEFAULT_BASE_URL=https://api.z.ai/api/paas/v4
VITE_AI_DEFAULT_MODEL=glm-4.7-flash
VITE_AI_DEFAULT_API_KEY_B64=
VITE_AI_DEFAULT_API_KEY=
VITE_AI_SECONDARY_BASE_URL=https://api.siliconflow.cn/v1
VITE_AI_SECONDARY_MODEL=Qwen/Qwen3.5-4B
VITE_AI_SECONDARY_API_KEY_B64=
VITE_AI_SECONDARY_API_KEY=
VITE_AI_FALLBACK_BASE_URL=https://api.deepseek.com/v1
VITE_AI_FALLBACK_MODEL=deepseek-v4-flash
VITE_AI_FALLBACK_API_KEY_B64=
VITE_AI_FALLBACK_API_KEY=
