ource":"scheduleDateMap"},"dataQuality":{"hasStructuredDepartureDates":true,"isDepartureDateReliable":true,"availabilityConfidence":"high","riskFlags":[]}},"dataQuality":{"hasStructuredDepartureDates":true,"isDepartureDateReliable":true,"availabilityConfidence":"high","riskFlags":[]}},{"id":"tour_4614","title":"【团队】【大溪地主场航次】庞洛邮轮·保罗高更号 法属波利尼西亚海域12天10晚","source":"广之旅","destination":"其他","duration":12,"price":84800,"priceUnit":"人","departureDate":"2026-10-02","transportType":"飞机往返","accommodationLevel":"舒适型","meals":"12早餐11正餐","singleSupplementNote":"","highlights":["产品特色","产品经理：本产品是一款高端、舒适、深度的顶级海岛度假产品。它结合了国际航班和奢华邮轮，将南太平洋多个分散的绝美岛屿串联起来，提供了最大化的便利性和最深度化的体验，非常适合追求与众不同、渴望一次玩遍南太平洋精华且注重旅行舒适度的独具慧眼的您。","①行程深入法属波利尼西亚的核心精华岛屿，一次性探访被誉为“上帝恩赐的礼物”的大溪地（帕皮提） 、充满原始魅力的胡阿希尼岛 (Huahine) 、神圣的文化中心若伊雅提岛 (Raiatea) 、浪漫的香草岛塔哈岛 (Taha'a) 以及终极天堂波拉波拉岛 (Bora Bora) 和茉莉雅岛 (Moorea) ，为您呈现南太平洋最璀璨的珍珠项链。","②精选航次：大溪地曾被美国《国家地理》杂志评为“世界十大度假胜地”之一，属于全球至美蜜月胜地行列。","③奢华邮轮：保罗高更号邮轮是五星全新翻新装修小型奢华邮轮，2019年荣膺《漫旅 Travel+Leisure》“世界旅行奖”最佳中型邮轮。","④独家航线&“地”道体验：全年巡航于大溪地及南太平洋群岛海域，游弋穿梭于大溪地的经典岛屿，特别探访保罗高更号的专属海滩和岛屿。团队致力于带领客人以「本地人」的方式，静心细品这片「只此青蓝」，探无止境。"],"rating":0,"bookingUrl":"http://nn.gzl.cn/cruises/4028804e9a114a2c019a537664ce229e.html","images":["https://file.gzl.cn/group1/M00/9F/DA/wKkBHmjKfCCAIvqgABfuCyRLsZw267.png"],"tags":["自然风光","纯玩","品质"],"isHot":true,"isNew":false,"isFlashSale":false,"groupSize":"30人常规团","theme":"自然风光","leisureLevel":"medium","suitableFor":["亲子","情侣"],"season":"全年","departureDates":["2026-10-02","2026-11-13","2026-12-11"],"hotDepartureDates":["2026-10-02","2026-11-13","2026-12-11"],"meta":{"aiTags":[],"sourceFeatures":[],"sourceAttributes":{"productType":"CRUISE","priceSource":"b2cMinPrice"},"dataQuality":{"hasStructuredDepartureDates":true,"isDepartureDateReliable":true,"availabilityConfidence":"high","riskFlags":[]}},"dataQuality":{"hasStructuredDepartureDates":true,"isDepartureDateReliable":true,"availabilityConfidence":"high","riskFlags":[]}},{"id":"tour_4616","title":"【尚·经典】韩国超值特惠、首尔、京畿道5/6天＊初游首选＊3大必