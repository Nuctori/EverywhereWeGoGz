青瓦古巷，品味老成都的烟火悠长；探访熊猫基地，邂逅萌态生灵治愈时光。走进三星堆博物馆，探秘古蜀文明的神秘悠远；漫步春熙路、太古里，触摸蓉城繁华潮流与都市风华。揽尽川西山水灵秀，品读千年人文底蕴，感受古蜀风情与都市烟火相融的万般景致。人生本就该奔赴山河盛景，放下俗世喧嚣，寻一方山水静心，赴一场蜀地之约，不负流年，不负人间好风光。"],"rating":0,"bookingUrl":"http://nn.gzl.cn/domestic/402880247469299e0174909ecdf47318.html","images":["https://file.gzl.cn/group1/M00/8E/99/wKkBH2c7_OWAAA-KACIq_HOKSmk92.jpeg"],"tags":["自然风光","纯玩","品质"],"isHot":true,"isNew":false,"isFlashSale":false,"groupSize":"30人常规团","theme":"自然风光","leisureLevel":"easy","suitableFor":["亲子","情侣"],"season":"全年","departureDates":["2026-05-30","2026-05-31","2026-06-01","2026-06-02","2026-06-03","2026-06-04","2026-06-05","2026-06-06","2026-06-07","2026-06-08","2026-06-09","2026-06-10","2026-06-11","2026-06-12","2026-06-13","2026-06-14","2026-06-15","2026-06-16","2026-06-17","2026-06-18","2026-06-19","2026-06-20","2026-06-21","2026-06-22","2026-06-23","2026-06-24","2026-06-25","2026-06-26","2026-06-27","2026-06-28","2026-06-29","2026-06-30","2026-07-01","2026-07-02","2026-07-03","2026-07-04","2026-07-05","2026-07-06","2026-07-07","2026-07-08","2026-07-09","2026-07-10","2026-07-11","2026-07-12","2026-07-13","2026-07-14","2026-07-15","2026-07-16","2026-07-17","2026-07-18","2026-07-19","2026-07-20","2026-07-21","2026-07-22","2026-07-23","2026-07-24","2026-07-25","2026-07-26","2026-07-27","2026-07-28","2026-07-29","2026-07-30","2026-07-31","2026-08-01","2026-08-02","2026-08-03","2026-08-04","2026-08-05","2026-08-06","2026-08-07","2026-08-08","2026-08-09","2026-08-10","2026-08-11","2026-08-12","2026-08-13","2026-08-14","2026-08-15","2026-08-16","2026-08-17","2026-08-18","2026-08-19","2026-08-20","2026-08-21","2026-08-22","2026-08-23","2026-08-24","2026-08-25","2026-08-26","2026-08-27","2026-08-28","2026-08-29","2026-08-30","2026-08-31"],"hotDepartureDates":["2026-05-30","2026-05-31","2026-06-01","2026-06-02"],"meta":{"aiTags":[],"sourceFeatures":[],"sourceAttributes":{"productType":"PRODUCTGROUP","priceSource":"scheduleDateMap"},"dataQuality":{"hasStructuredDepartureDates":true,