okingUrl":"http://nn.gzl.cn/domestic/2c9082e49d3c30cc019d42b661f45739.html","images":["/data/image-cache/file.gzl.cn/a706a80ec2a471ec.webp"],"tags":["户外徒步","纯玩","品质"],"isHot":false,"isNew":false,"isFlashSale":false,"groupSize":"30人常规团","theme":"户外徒步","leisureLevel":"hard","suitableFor":["亲子","情侣"],"season":"全年","departureDates":[],"hotDepartureDates":[]},{"id":"tour_1861","title":"【跟团游】东兴2天＊大清国一号界碑＊万尾金滩＊湛江往返＜乐＞","source":"广之旅","destination":"其他","duration":2,"price":278,"priceUnit":"人","departureDate":"","transportType":"大巴往返","accommodationLevel":"舒适型","meals":"2早餐1正餐","singleSupplementNote":"","highlights":["产品特色","特色瑶家长桌喜宴餐","体验森林探险、激情漂流、瑶寨风情、农家乐","两岸有奇石、果林，漂流忽转忽旋","急驰而下，大浪扑面，让你秒秒钟嚎吼与尖叫，险滩充满刺激","与越南海陆相连的口岸"],"rating":0,"bookingUrl":"http://nn.gzl.cn/around/402880246420c3060164364465a507aa.html","images":["/data/image-cache/file.gzl.cn/f706fa1a3fb15f08.webp"],"tags":["自然风光","纯玩","品质"],"isHot":false,"isNew":false,"isFlashSale":false,"groupSize":"30人常规团","theme":"自然风光","leisureLevel":"easy","suitableFor":["亲子","情侣"],"season":"全年","departureDates":[],"hotDepartureDates":[]},{"id":"tour_1862","title":"【典·休闲】四川、成都双飞5/6天＊恋上四川＊黄龙＊都江堰＊九寨沟＊湛江往返","source":"广之旅","destination":"四川","duration":6,"price":2899,"priceUnit":"人","departureDate":"2026-05-06","transportType":"飞机往返","accommodationLevel":"舒适型","meals":"6早餐5正餐","singleSupplementNote":"","highlights":["产品特色","★湛江成都直飞航班往返；","★游览自然文化遗产【乐山大佛】【峨眉山】；","★都江宴，品四川变脸火锅"],"rating":0,"bookingUrl":"http://nn.gzl.cn/domestic/402880225ec3abd7015f141a411806d7.html","images":["/data/image-cache/file.gzl.cn/a179d5c30a1facd2.webp"],"tags":["自然风光","纯玩","品质"],"isHot":false,"isNew":false,"isFlashSale":false,"groupSize":"30人常规团","theme":"自然风光","leisureLevel":"easy","suitableFor":["亲子","情侣"],"season":"全年","departureDates":["2026-05-06"],"hotDepartureDates":["2026-05-06"]},{"id":"tour_1863","title":"【川西深度游】成都、稻城8天＊四姑娘山＊墨石公园＊稻城亚丁＊天路十八弯＊宽窄巷子＊等待确认＜成都四姑娘山稻城亚丁新都桥八天＞","source":"广之旅","destination":"四川","duration":8,"price":6599,"priceUnit":"人","departureDate":"","transportType":"飞机往返","accommodationLevel":"舒适型","meals":"8早餐7正餐","singleSupplementNote":"","highlights":["产品特色","行程亮点","稻城亚丁，被誉为蓝色星球上最后一片净土，藏于川西高原深处，是名副其实的最后的香格里拉。这里有巍峨圣洁的三座神山、澄澈静谧的高山海子、辽阔纯净的草甸林海，蓝天白云相伴，风光原始又治愈。奔赴稻城亚丁，是一场与雪山、云海、高原秘境的温柔邂逅，远离城市喧嚣，沉浸式感受藏地的纯净与辽阔，开启一场洗涤心灵的高原之旅。","行程特色","旅行在这片纯洁的土地之上，在四姑娘山层峦雪峰与幽深峡谷之中穿行，在塔公草原万顷草甸之上看漫山经幡，探秘墨石公园嶙峋奇石与异域地貌，远赴稻城亚丁感受圣洁神山与澄澈海子。徜徉雪域山河画卷，邂逅藏地人文风情，欣赏高原万顷盛景，奔赴这片远离红尘烟火与不染俗世尘埃的栖居净土。人生本就应该绽放在沿途山河风月之中。放下心头纷扰，让灵魂奔赴山野，让心灵归于远方，不负时光，不负山河。"],"rating":0,"bookingUrl":"http://nn.gzl.cn/domestic/402880247c0d7944017c34b1a54c5ef1.html","images":["/data/image-cache/file.gzl.cn/66846d0232fce88f.webp"],"tags":["自然风光","纯玩","品质"],"isHot":false,"isNew":false,"isFlashSale":false,"groupSize":"30人常规团","theme":"自然风光","leisureLevel":"medium","suitableFor":["亲子","情侣"],"season":"全年","departureDates":[],"hotDepartureDates":[]},{"id":"tour_1864","title":"【长海之上观流云】成都、峨眉山6天＊乐山大佛游船＊峨眉山金顶＊都江堰熊猫谷＊黄龙溪古镇＊宽窄巷子＊等待确认＜私享之旅＞","source":"广之旅","destination":"四川","duration":6,"price":4899,"priceUnit":"人","departureDate":"","transportType":"飞机往返","accommodationLevel":"舒适型","meals":"6早餐5正餐","singleSupplementNote":"","highlights":["产品特色","行程亮点","峨眉山，被誉为仙山佛国、峨眉天下秀，是名副其实的佛教圣地与自然奇观。这里有巍峨庄严的金顶佛殿、缥缈灵动的山间云海、清幽雅致的清音叠翠，禅意梵音与青山秀水相融，风光雄奇又温婉。奔赴峨眉山，是一场与金顶、云海、禅境秘境的温柔邂逅，远离尘世纷扰，沉浸式感受山水的灵秀与佛韵的悠远，开启一场安放心灵的禅意之旅。","行程特色","旅行沉醉在蜀地温润的山水人文间，在都江堰熊猫谷邂逅国宝萌态，于千年水利工程品读李冰治水智慧。偷得半日闲，静坐提笔静心抄经，伴一曲仙音疗愈，褪去浮躁，安放疲惫。","走进钟书阁邂逅书海秘境，夜幕赴都江堰蓝眼泪之约，看星河般蓝光映亮江水。踏足乐山大佛感受佛韵与山水共生，攀登峨眉山，在金顶云海间体悟仙山禅意。"],"rating":0,"bookingUrl":"http://nn.gzl.cn/domestic/4028802478ff54d201791c9a64866094.html","images":["/data/image-cache/file.gzl.cn/15781c0ff3086c74.webp"],"tags":["古镇文化","纯玩","品质"],"isHot":false,"isNew":false,"isFlashSale":false,"groupSize":"30人常规团","theme":"古镇文化","leisureLevel":"easy","suitableFor":["亲子","情侣"],"season":"全年","departureDates":[],"hotDepartureDates":[]},{"id":"tour_1865","title":"【成都九寨沟黄龙五天】成都5天＊黄龙风景名胜区＊全天九寨沟之旅＊三星堆博物馆＊成都自由行city walk＊等待确认＜私享之旅＞","source":"广之旅","destination":"四川","duration":5,"price":3299,"priceUnit":"人","departureDate":"","transportType":"高铁往返","accommodationLevel":"舒适型","meals":"5早餐4正餐","singleSupplementNote":"","highlights":["产品特色","行程亮点","九寨沟，被誉为人间仙境、童话世界，藏于四川阿坝岷山深处，是名副其实的水景之王。这里有碧蓝澄澈的百颗海子、气势磅礴的叠瀑飞泉、层林尽染的彩林雪峰，藏羌风情与碧水青山相融，风光灵秀又治愈。奔赴九寨沟，是一场与彩池、飞瀑、层林秘境的温柔邂逅，远离城市喧嚣，沉浸式感受山水的纯净与灵动，开启一场洗涤心灵的自然之旅。","行程特色","旅行沉醉在蜀地温婉的山水人文之间，在九寨沟碧水彩池与叠瀑林海之中流连漫步，于黄龙瑶池彩潭间邂逅人间仙境，踏足武侯祠红墙竹影品读三国古韵。穿行宽窄巷子青瓦古巷，品味老成都的烟火悠长；探访熊猫基地，邂逅萌态生灵治愈时光。走进三星堆博物馆，探秘古蜀文明的神秘悠远；漫步春熙路、太古里，触摸蓉城繁华潮流与都市风华。揽尽川西山水灵秀，品读千年人文底蕴，感受古蜀风情与都市烟火相融的万般景致。人生本就该奔赴山河盛景，放下俗世喧嚣，寻一方山水静心，赴一场蜀地之约，不负流年，不负人间好风光。"],"rating":0,"bookingUrl":"http://nn.gzl.cn/domestic/402880247469299e0174909ecdf47318.html","images":["/data/image-cache/file.gzl.cn/58f86e26d23c8a4d.webp"],"tags":["自然风光","纯玩","品质"],"isHot":false,"isNew":false,"isFlashSale":false,"groupSize":"30人常规团","theme":"自然风光","leisureLevel":"easy","suitableFor":["亲子","情侣"],"season":"全年","departureDates":[],"hotDepartureDates":[]},{"id":"tour_1866","title":"【九寨黄龙毕棚沟四姑娘山达古冰川七天】成都7天＊九寨沟风景区＊黄龙风景区＊四姑娘山＊达古冰川＊毕棚沟景区＊等待确认＜漫步川西小瑞士＞","source":"广之旅","destination":"四川","duration":7,"price":5899,"priceUnit":"人","departureDate":"","transportType":"飞机往返","accommodationLevel":"舒适型","meals":"7早餐6正餐","singleSupplementNote":"","highlights":["产品特色","n度假首选","专属的私密之旅，无需与陌生人拼团，随走随停，尽享私人空间；","优选领队带队，专车司机，私人向导，无任隐形消费，回归旅行本质；","甄选酒店，为您带来更舒适的住宿体验，让您游玩更便捷，休息更充分；","每车配备氧气瓶、旅游三宝、一箱矿泉水；"],"rating":0,"bookingUrl":"http://nn.gzl.cn/domestic/4028804f78ff5d88017944aebf601b4a.html","images":["/data/image-cache/file.gzl.cn/e9282e22a599f20e.webp"],"tags":["冰雪世界","纯玩","品质"],"isHot":false,"isNew":false,"isFlashSale":false,"groupSize":"30人常规团","theme":"冰雪世界","leisureLevel":"easy","suitableFor":["亲子","情侣"],"season":"全年","departureDates":[],"hotDepartureDates":[]},{"id":"tour_1867","title":"【典·全景】成都6天＊成都双飞＊九寨沟深度一天游＊黄龙＊岷江源头＊湛江往返","source":"广之旅","destination":"四川","duration":7,"price":4039,"priceUnit":"人","departureDate":"","transportType":"飞机往返","accommodationLevel":"舒适型","meals":"7早餐6正餐","singleSupplementNote":"","high