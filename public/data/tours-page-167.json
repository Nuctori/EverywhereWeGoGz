79a086a.html","images":["/data/image-cache/file.gzl.cn/43678ee5ef95a051.webp"],"tags":["自然风光","纯玩","品质"],"isHot":false,"isNew":false,"isFlashSale":false,"groupSize":"30人常规团","theme":"自然风光","leisureLevel":"medium","suitableFor":["亲子","情侣"],"season":"全年","departureDates":["2027-08-26"],"hotDepartureDates":["2027-08-26"]},{"id":"tour_4804","title":"【维京海轮船票 － 欧洲地中海】西地中海经典之旅ﾠ“罗马－ 巴塞罗那” － 8天7晚＜二次确认＞","source":"广之旅","sourceId":"2c9080099c214fda019c46c9f6c9599a","destination":"其他","duration":8,"price":32299,"priceUnit":"人","departureDate":"2027-02-08","transportType":"飞机往返","accommodationLevel":"舒适型","meals":"8早餐7正餐","singleSupplementNote":"","highlights":["产品特色","航行于亚得里亚海与爱奥尼亚海之间，揭开古老文明的辉煌记忆。以水城威尼斯的潋滟波光为序曲，探访斯普利特的 千年宫殿，漫步杜布罗夫尼克的中世纪街巷，沉醉于科托尔古城与峡湾交织的山海奇景。在科孚岛领略旧日风华，于 奥林匹亚追寻古奥运圣火之源。","在希腊科孚岛邂逅地中海梦幻之岛，漫游世遗古城探寻《权力的游戏》取景地杜布罗夫尼克的中世纪古城魅力","走进威尼斯，领略动人心弦的水城风情","邂逅黑山科托尔千年古城与峡湾交织的山海奇观走进奥林匹亚古奥运会发源地，仰望宙斯神庙的众神遗风","船票一价全含：船票&指定机场接送机服务&岸上游览&中文导游服务&船上餐饮&船上文娱；"],"rating":0,"bookingUrl":"http://nn.gzl.cn/cruises/2c9080099c214fda019c46c9f6c9599a.html","images":["/data/image-cache/file.gzl.cn/c95eb77f14d9868f.webp"],"tags":["自然风光","纯玩","品质"],"isHot":false,"isNew":false,"isFlashSale":false,"groupSize":"30人常规团","theme":"自然风光","leisureLevel":"medium","suitableFor":["亲子","情侣"],"season":"全年","departureDates":["2027-02-08"],"hotDepartureDates":["2027-02-08"]}]}
