{"geo":{"departure":{"placeId":"018572523be9ed98","name":"广州","normalizedName":"广州","country":"中国","province":"广东","city":"广州","latitude":23.1291,"longitude":113.2644,"coordinateSystem":"wgs84","level":"city","coordinateSource":"catalog","precision":"approximate","source":"catalog","confidence":"medium"},"destination":{"placeId":"aad7f81f8e6e3ca8","name":"江门","normalizedName":"江门","country":"中国","province":"广东","city":"江门","latitude":22.5787,"longitude":113.0815,"coordinateSystem":"wgs84","level":"city","coordinateSource":"catalog","precision":"approximate","source":"catalog","confidence":"medium"},"stops":[],"status":"complete","routeRegion":"local"},"sourceLogo":"/icons/广州康辉.png","departureCity":"广州","departureProvince":"广东","departureCountry":"中国","destinationCity":"江门","destinationPlaceName":"江门","destinationProvince":"广东","destinationCountry":"中国","destinationLatitude":22.5787,"destinationLongitude":113.0815,"destinationGeoLevel":"city","destinationLocality":"","destinationCoordinateSource":"catalog","destinationCoordinatePrecision":"approximate","geoStatus":"complete","geoConfidence":"medium","geoSource":"local-place-catalog","geoResolution":{"input":{"destination":"广东省江门市","hasTitle":true,"itineraryDays":1,"accommodationDays":0,"highlightCount":0},"mining":{"status":"resolved","candidateSources":["destination"],"candidateLabels":["江门"],"rejectedLabels":[],"reasons":[],"sourceCandidates":[]},"osm":{"status":"not-run"},"geocoder":{"status":"not-run","queries":[]},"final":{"status":"unmapped"}},"departureLatitude":23.1291,"departureLongitude":113.2644,"departureGeoLevel":"city","departureLocality":"","departureCoordinateSource":"catalog","routeRegion":"local","returnDate":"","accommodationStars":0,"accommodationDetails":[],"serviceStatus":{"visaRequirements":"unknown","travelInsurance":"unknown","tourGuideService":"included"},"singleSupplement":0,"availableSeats":0,"totalSeats":0,"itinerary":[{"day":1,"title":"","description":"含午餐 广州—石涧公园—午餐—新会柑园任吃—崖门渔人码头—稻谷脱粒—广州 用餐 含午餐 （集中时间地点如有变动按导游通知为准），乘车前往【石涧公园】（游览约2小时），新会“小九寨”之称的【石涧公园】公园水杉林更适合痴迷红叶的游人，澄澈的湖面、暖阳的倒影、缤纷的彩林……说起石涧公园，很多街坊都曾到此打卡，它的水上杉林向来是网红打卡点，这里的亲水栈道，更是观赏杉树的最佳地点…… 午餐美食品《湛江靓鸡·牛肉火锅美食宴》。 后乘车后前往【百亩柑园现吃】（游览约30分钟，含每人送2斤）每年10月份-12月是新会大红柑成熟季节，新会大红柑也是新会陈皮唯一原材料。走进百亩柑园，客人于金黄色的大红柑海中任意品尝新鲜大红柑（为了尊重农民的辛勤劳动成果和对大红柑树的保护，果园内将安排专业的采摘工为游客摘取新鲜果实，提供至新鲜的大红柑给予各位贵宾品尝）。 前往【新会渔人码头】（游览约30分钟）崖门渔港矗立在天与海的交界线，其中心建筑——灯塔成为受市民追捧的“网红打卡点”。圆顶造型，蓝白配色，灯塔是属于海边的经典景点。 前往新会【崖门镇】，进行【收割水稻、稻谷脱粒】（游览约40分钟）体验活动，可以在规定范围内进行亲身体验收割水稻的乐趣，在体验中领悟珍惜粮食的道理，然后将手中的稻谷到打谷机旁进行脱谷体验。（温馨提示：记得在体验中要爱护粮食，不要踩踏浪费哦）。 游览完毕后，结束愉快的旅程！回程地点：统一越秀公园散团。"}],"inclusions":["1.交通：按实际人数安排旅游大巴，保证一人一正位。 2.用餐：全程1正餐1品果，正餐餐标30元/正，8-13人一围，此为团队用餐，若游客放弃用餐，恕不另行退费，请游客谅解。人数增减时，菜量相应增减，但维持餐标不变，不含酒水，整团少于5人退餐。 3.门票：景点大门票。 4.其它：导游服务。 5.儿童价：大小同价。 6.赠送1人2斤新会柑+1斤富硒大米（18岁以上成人赠送，18岁以下小童不赠送） 7.本团全团已做接待成本综合调控，不因单一门票免费政策(含60岁及以上老年人、残疾人、离休干部、70岁及以上老人、现役军人、残疾军人等)再个别调减团费事由，敬请客人谅解。"],"exclusions":[],"optionalExpenses":[],"importantNotes":[],"visaRequirements":"","travelInsurance":false,"tourGuideService":false,"freeWiFi":false,"childPolicy":"","cancellationPolicy":"","refundPolicy":"","reviewCount":0,"difficulty":"","language":"","createdAt":"2026-11-23T22:45:38.330817","updatedAt":"2026-11-23T22:45:38.330817"}
