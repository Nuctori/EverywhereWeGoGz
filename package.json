{
  "name": "my-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b",
    "data:crawl": "python scripts/crawl_unified_sources.py",
    "data:merge": "python scripts/merge_data.py",
    "data:mine-source-geo": "python scripts/source_geo_enrichment.py --network --write --workers 8",
    "data:refresh": "npm run data:crawl && npm run data:merge && npm run data:mine-source-geo && npm run data:rebuild-geo -- --network && npm run data:images:webp && npm run audit:data-integrity",
    "build": "npm run data:split && npm run data:images:webp && npm run audit:structured-tour-data && npm run audit:data-integrity && tsc -b && vite build",
    "build:pages": "npm run data:split && npm run data:images:webp && npm run audit:structured-tour-data && npm run audit:initial-data-loading && tsc -b && vite build",
    "data:split": "node scripts/split_tour_data.mjs",
    "data:images:webp": "node scripts/optimize_image_cache.mjs",
    "audit:data-integrity": "node scripts/audit_data_integrity.mjs",
    "audit:data-integrity:rules": "node scripts/test_audit_data_integrity_rules.mjs",
    "audit:crawler-syntax": "node scripts/test_crawler_syntax.mjs",
    "report:destination-mining": "python scripts/report_destination_mining.py",
    "data:rebuild-geo": "python scripts/rebuild_geo_data.py",
    "audit:geocode-destinations": "python scripts/test_geocode_destinations.py",
    "audit:geo-coverage": "node scripts/test_geo_coverage.mjs",
    "audit:deploy-workflow": "node scripts/test_deploy_workflow.mjs",
    "test:static-asset-fallback": "node scripts/test_static_asset_fallback.mjs",
    "test:cdn-pool": "node scripts/test_cdn_pool.mjs",
    "audit:jrt365-crawl-guard": "node scripts/test_jrt365_crawl_guard.mjs",
    "audit:update-data-workflow": "node scripts/test_update_data_workflow.mjs",
    "audit:push-generated-commit": "node scripts/test_push_generated_commit.mjs",
    "audit:merge-data-observability": "node scripts/test_merge_data_observability.mjs",
    "audit:structured-tour-fields": "python scripts/test_structured_tour_enrichment.py",
    "audit:structured-tour-data": "python scripts/audit_structured_tour_fields.py",
    "test:runtime-tour-schemas": "node --experimental-strip-types --loader ./scripts/ts-alias-loader.mjs scripts/test_runtime_tour_schemas.mjs",
    "audit:ai-interaction-performance": "node scripts/audit_ai_interaction_performance.mjs",
    "audit:ai-chat-storage": "node --no-warnings --experimental-strip-types --loader ./scripts/ts-alias-loader.mjs scripts/audit_ai_chat_storage.ts",
    "audit:ai-recommendation": "node --experimental-strip-types --loader ./scripts/ts-alias-loader.mjs scripts/audit_ai_recommendation.ts",
    "audit:ai-success-path": "node --experimental-strip-types --loader ./scripts/ts-alias-loader.mjs scripts/audit_ai_success_path.ts",
    "audit:display-semantics": "node --experimental-strip-types --loader ./scripts/ts-alias-loader.mjs scripts/audit_display_semantics.ts",
    "audit:initial-data-loading": "node scripts/test_initial_data_loading.mjs",
    "test:tour-deeplink": "node --experimental-strip-types scripts/test_tour_deeplink.mjs",
    "test:destination-aliases": "node --experimental-strip-types --loader ./scripts/ts-alias-loader.mjs scripts/test_destination_aliases.ts",
    "test:search-modes-ui": "node scripts/test_search_modes_ui.mjs",
    "audit:availability": "python scripts/validate_tour_availability.py",
    "test:geo-schema-guard": "python scripts/test_geo_schema_guard.py",
    "test:geo-data-layer": "node scripts/test_geo_data_layer.mjs",
    "test:map-data-loading": "node scripts/test_map_data_loading.mjs",
    "test:split-tour-data-newlines": "node scripts/test_split_tour_data_newlines.mjs",
    "test:osm-poi-workflow": "node scripts/test_osm_poi_workflow.mjs",
    "test:map-view-contract": "node scripts/test_map_view_contract.mjs",
    "test:map-runtime": "node scripts/test_map_runtime_e2e.mjs",
    "test:map-place-chunks": "node scripts/test_map_place_chunks_e2e.mjs",
    "audit:availability:refresh": "python scripts/validate_tour_availability.py --cache-ttl-hours 0 --sample-failures 0",
    "generate:weekly-wechat-article": "node scripts/generate_weekly_wechat_article.mjs",
    "prepare:wechat-publish-bundle": "node scripts/prepare_wechat_publish_bundle.mjs",
    "publish:wechat-draft": "node scripts/publish_wechat_draft.mjs",
    "test:departure-date-display": "node --experimental-strip-types --loader ./scripts/ts-alias-loader.mjs scripts/test_departure_date_display.ts",
    "test:source-detail-url": "node --experimental-strip-types --loader ./scripts/ts-alias-loader.mjs scripts/test_source_detail_url.mjs",
    "test:weekly-wechat-article": "node scripts/test_weekly_wechat_article.mjs",
    "test:weekly-wechat-agent-cli": "node scripts/test_weekly_wechat_agent_cli.mjs",
    "test:wechat-publish-bundle": "node scripts/test_prepare_wechat_publish_bundle.mjs",
    "test:wechat-publish": "node scripts/test_wechat_publish.mjs",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.12",
